{
  "name": "thunder-run",
  "version": "0.1.0",
  "private": true,
  "description": "雷霆酷跑：框架与游戏共存的简洁 monorepo。",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && node tools/build-replay-runtime.mjs",
    "watch": "tsc -b --watch",
    "test": "node --test tests/*.test.mjs",
    "validate-config": "node tools/validate-config.mjs",
    "check-imports": "node tools/check-import-rules.mjs",
    "check": "node tools/check.mjs",
    "dev": "npm run build && npm run dev --workspace @tr/web",
    "dev:server": "npm run build && npm run start --workspace @tr/server",
    "build:web": "npm run build && npm run build --workspace @tr/web",
    "build:wx": "npm run build && node tools/build-wx.mjs",
    "preview:web": "npm run preview --workspace @tr/web",
    "test:e2e": "npm run build:web && node tools/e2e-smoke.mjs"
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
