[Unit]
Description=Thunder Run daily/weekly mission API
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=thunder-run-missions
StateDirectoryMode=0700
WorkingDirectory=/opt/thunder-run-missions/current
EnvironmentFile=/etc/default/thunder-run-missions
ExecStart=/usr/local/bin/node /opt/thunder-run-missions/current/apps/server/src/main.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
