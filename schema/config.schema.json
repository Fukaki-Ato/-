{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fukaki-Ato/-/schema/config.schema.json",
  "title": "Thunder Run configuration envelope and primitive contract",
  "description": "Runtime validation owns cross-file references and detailed gameplay rules.",
  "$defs": {
    "catalog": {
      "type": "object",
      "required": ["configVersion", "items"],
      "properties": {
        "$schema": { "type": "string" },
        "configVersion": { "type": "string" },
        "minEngineVersion": { "type": "string" },
        "updatedAt": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "versions"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "versions": { "type": "array", "minItems": 1 },
              "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "required": ["primitive"],
      "properties": {
        "primitive": {
          "enum": [
            "invincible",
            "speedMul",
            "magnet",
            "fly",
            "lifeAdd",
            "jumpBoost",
            "dash",
            "blink",
            "timeSlow",
            "shieldAdd",
            "buffDurationAdd",
            "coinValueAdd",
            "scoreAdd",
            "spawnCoinsRow",
            "laneAutoAvoid",
            "pickupAll",
            "slideExtend",
            "cooldownMul",
            "boardArmor",
            "buffDurationFlat",
            "slideGuard",
            "duckPass",
            "smashAhead",
            "periodic",
            "xpMul"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "game": {
    "type": "object",
    "required": ["configVersion", "params"],
    "properties": {
      "$schema": { "type": "string" },
      "configVersion": { "type": "string" },
      "minEngineVersion": { "type": "string" },
      "updatedAt": { "type": "string" },
      "params": {
        "type": "object",
        "properties": {
          "runner": {
            "type": "object",
            "properties": {
              "baseSpeed": { "type": "number" },
              "maxSpeed": { "type": "number" },
              "speedRampPer100M": { "type": "number" },
              "gravity": { "type": "number" },
              "jumpVelocity": { "type": "number" },
              "holdJumpMaxMs": { "type": "number" },
              "slideS": { "type": "number" },
              "slideCooldownS": { "type": "number" },
              "lives": { "type": "number" },
              "laneWidth": { "type": "number" },
              "laneChangeS": { "type": "number" },
              "hitStunS": { "type": "number" },
              "invulnS": { "type": "number" },
              "spawnGraceS": { "type": "number" },
              "coinCollectM": { "type": "number" }
            },
            "additionalProperties": true
          },
          "ui": { "type": "object" },
          "audio": {
            "type": "object",
            "properties": {
              "volume": {
                "type": "object",
                "properties": {
                  "music": { "type": "number" },
                  "sfx": { "type": "number" }
                },
                "additionalProperties": true
              },
              "bgm": {
                "type": "object",
                "properties": {
                  "run": { "type": "string", "description": "局内循环 BGM" },
                  "death": { "type": "string", "description": "死亡一次性 BGM（不循环，延续到结算页）" }
                },
                "additionalProperties": true
              },
              "sfx": {
                "type": "object",
                "properties": {
                  "start": { "type": "string", "description": "开局音效" },
                  "death": {
                    "description": "全局死亡音效：旧版单路径，或非空路径池（每次随机一条）",
                    "anyOf": [
                      { "type": "string" },
                      { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                    ]
                  }
                },
                "additionalProperties": true
              },
              "characters": {
                "type": "object",
                "description": "角色 id → 角色专属音效",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "sfx": {
                      "type": "object",
                      "properties": {
                        "cast": { "type": "string" },
                        "pickup": { "type": "string" },
                        "death": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  },
  "characters": { "$ref": "#/$defs/catalog" },
  "skills": { "$ref": "#/$defs/catalog" },
  "items": { "$ref": "#/$defs/catalog" },
  "themes": { "$ref": "#/$defs/catalog" },
  "events": { "$ref": "#/$defs/catalog" },
  "economy": {
    "type": "object",
    "required": ["configVersion", "params"],
    "properties": {
      "$schema": { "type": "string" },
      "configVersion": { "type": "string" },
      "params": { "type": "object" }
    },
    "additionalProperties": true
  },
  "obstacles": {
    "type": "object",
    "required": ["configVersion", "defs", "patterns", "difficultyCurve"],
    "properties": {
      "$schema": { "type": "string" },
      "configVersion": { "type": "string" },
      "defs": { "type": "array" },
      "patterns": { "type": "array" },
      "difficultyCurve": { "type": "array" },
      "zap": { "type": "object" }
    },
    "additionalProperties": true
  }
}
